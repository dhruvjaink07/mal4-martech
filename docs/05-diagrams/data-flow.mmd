graph TD
    subgraph Submit["Submission flow"]
        direction TB
        Marketer(["Marketer"]) --> UC1["SubmitCampaign"]
        UC1 -->|"load"| Repo1[("CampaignRepository")]
        UC1 -->|"submit()"| Agg1["Campaign aggregate"]
        Agg1 -->|"new version + state"| UC1
        UC1 -->|"save"| Repo1
        Repo1 -->|"atomic commit"| DB1[("Local DB")]
        UC1 -->|"emit event<br/>(after commit)"| Events1(["Event Bus"])
        Events1 -.->|"best-effort async<br/>NFR-005"| Marketer
    end

    subgraph Review["Review flow"]
        direction TB
        Reviewer(["Reviewer"]) --> UC2["ReviewCampaign"]
        UC2 -->|"load (fresh)"| Repo2[("CampaignRepository")]
        UC2 -->|"compare version"| Agg2["Campaign aggregate"]
        Agg2 -->|"StaleReviewError<br/>if mismatch"| UC2
        UC2 -->|"save"| Repo2
        Repo2 -->|"ConcurrentModificationError<br/>if advanced"| UC2
        UC2 --> Reviewer
    end

